---
// One page per case study at /work/<slug>, with the layout its `format`
// asks for, plus the component test page at /work/_kit.
import { getCollection } from 'astro:content';
import CaseLayout from '../../layouts/CaseLayout.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import Kit from '../../components/case/Kit.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return [
    ...entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
    { params: { slug: '_kit' }, props: { kit: true } },
  ];
}

const { entry, kit } = Astro.props;
---
{kit ? <Kit /> : entry.data.format === 'app' ? <AppLayout entry={entry} /> : <CaseLayout entry={entry} />}
