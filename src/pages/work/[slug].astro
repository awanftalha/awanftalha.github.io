---
// One page per case study at /work/<slug>, plus the component test page at
// /work/_kit. Phase 2: the case pages are still shells; Phase 3 adds the
// layouts.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kit from '../../components/case/Kit.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return [
    ...entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
    { params: { slug: '_kit' }, props: { kit: true } },
  ];
}

const { entry, kit } = Astro.props;
const d = entry?.data;
---
{kit ? <Kit /> : (
  <Base title={d.title} description={d.seo.description} path={`/work/${entry.id}`} ogImage={d.seo.ogImage}>
    <section class="cs-stub">
      <ul class="cs-stub__chips" aria-label="About this project">
        {d.eyebrow.map((e) => <li class="chip">{e}</li>)}
      </ul>
      <h1 class="cs-stub__title">{d.title}</h1>
      <p class="cs-stub__intro">{d.intro}</p>
      <p class="cs-stub__note muted">Phase 1 shell. The full case study layout arrives in Phase 3.</p>
    </section>
  </Base>
)}

<style>
  .cs-stub { padding: calc(var(--nav-h) + 120px) var(--gutter) 160px; max-width: 62ch; }
  .cs-stub__chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .cs-stub__title { margin-top: 24px; font-size: var(--fs-h1); line-height: 1; letter-spacing: var(--track-display); }
  .cs-stub__intro { margin-top: 16px; font-size: var(--fs-intro); line-height: 1.3; }
  .cs-stub__note { margin-top: 48px; }
</style>
