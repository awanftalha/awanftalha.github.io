---
// 4.19 DeviceStrip: a horizontal scroll-snap row of screens, each Figure in
// a CSS device frame. Arrow buttons on desktop, swipe on touch, and the
// row itself takes keyboard focus and scrolls with the arrow keys.
interface Props { device?: 'phone' | 'tablet' | 'desktop' }
const { device = 'phone' } = Astro.props;
---
<div class:list={['cs-strip', 'cs-devices', `device-${device}`]} data-strip>
  <div class="cs-strip__track" tabindex="0" role="region" aria-label="Screens, scroll sideways">
    <slot />
  </div>
  <div class="cs-strip__controls">
    <span class="cs-strip__progress" aria-hidden="true"><span data-strip-bar></span></span>
    <button class="icon-btn" type="button" data-strip-prev aria-label="Previous screens">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <button class="icon-btn" type="button" data-strip-next aria-label="Next screens">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>
</div>
