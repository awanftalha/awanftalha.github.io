---
// Wraps consecutive Moments (added at build time by remark-case.mjs) into a
// horizontal scroll-snap strip with a progress line.
---
<div class="cs-strip cs-moments is-wide" data-strip>
  <div class="cs-strip__track" tabindex="0" role="region" aria-label="Steps, scroll sideways">
    <slot />
  </div>
  <div class="cs-strip__controls">
    <span class="cs-strip__progress" aria-hidden="true"><span data-strip-bar></span></span>
    <button class="icon-btn" type="button" data-strip-prev aria-label="Previous steps">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <button class="icon-btn" type="button" data-strip-next aria-label="Next steps">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>
</div>
